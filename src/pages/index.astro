---
import BaseLayout from '../layouts/BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
import ProfileCard from '../components/ProfileCard.astro';
import HotPosts from '../components/HotPosts.astro';
import PostCard from '../components/PostCard.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import { readingTime } from '../utils/reading';

const allPosts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = allPosts.slice(0, 4);
const rt = new Map(posts.map((p) => [p.id, readingTime(p.body ?? '')]));
const latest = allPosts[0]?.data.date;
const latestStr = latest
  ? `${latest.getFullYear()}-${String(latest.getMonth() + 1).padStart(2, '0')}-${String(latest.getDate()).padStart(2, '0')}`
  : '';
---

<BaseLayout title={site.title} description={site.description}>
  <div class="shell">
    <aside class="side-left"><SideNav /></aside>

    <div class="content">
      <div class="content-head">
        <h1>最新文章</h1>
        <p>共 {allPosts.length} 篇 · 最近更新 {latestStr}</p>
      </div>

      {posts.map((p) => <PostCard post={p} readingTime={rt.get(p.id) ?? 1} />)}

      <Cta />
    </div>

    <aside class="side-right">
      <ProfileCard />
      <HotPosts />
    </aside>
  </div>
</BaseLayout>
