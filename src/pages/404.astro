---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`页面不存在 — ${site.name}`} description="这个页面不存在，可能是链接过期了。">
  <div class="shell shell--center">
    <div class="content">
      <section class="nf">
        <h1>404</h1>
        <p>这个页面不存在。可能是链接过期了，或者我改过文章地址。</p>
        <div class="nf__actions">
          <a class="btn btn--primary btn--lg" href="/">回到首页</a>
          <a class="btn btn--ghost btn--lg" href="/writing/">看文章</a>
          <a class="btn btn--ghost btn--lg" href="/projects/">看项目</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
