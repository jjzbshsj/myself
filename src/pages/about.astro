---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import HotPosts from '../components/HotPosts.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`关于 — ${site.name}`}
  description={`${site.name}，${site.role}。${site.tagline}`}
>
  <div class="shell">
    <aside class="side-left">
      <div class="side-box">
        <h4>本页目录</h4>
        <a class="side-link" href="#bio">简介</a>
        <a class="side-link" href="#timeline">经历</a>
        <a class="side-link" href="#now">现在</a>
      </div>
    </aside>

    <div class="content">
      <div class="content-head">
        <h1>关于</h1>
        <p>{site.name} · {site.role}</p>
      </div>

      <section id="bio">
        <p class="about-lead">{site.about.lead}</p>
        {site.about.paragraphs.map((p) => (
          <p class="about-para">{p}</p>
        ))}
      </section>

      <section id="timeline" style="margin-top:32px">
        <h2 style="font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 16px">经历</h2>
        <ol class="timeline">
          {site.about.timeline.map((t) => (
            <li>
              <span class="timeline__period">{t.period}</span>
              <p class="timeline__title">{t.title}</p>
              <p class="timeline__desc">{t.desc}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="now" style="margin-top:32px">
        <h2 style="font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 16px">现在</h2>
        <p class="about-para">
          {site.tagline}。目前在做第四个开源项目和一批无障碍改进。
          如果你想聊聊技术或合作，欢迎发邮件到
          <a href={`mailto:${site.email}`} style="color:var(--accent);border-bottom:1px solid #c7d8fe">{site.email}</a>。
        </p>
      </section>
    </div>

    <aside class="side-right">
      <ProfileCard />
      <HotPosts />
    </aside>
  </div>
</BaseLayout>
