---
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/writing/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/about/', label: '关于' },
];

const isActive = (href: string) => {
  const h = href.replace(/\/$/, '');
  return path === h || path.startsWith(h + '/');
};
---

<header class="topbar">
  <div class="topbar__inner">
    <a class="brand" href="/" aria-label="返回首页">
      <span class="brand__mark" aria-hidden="true">{site.name.slice(0, 1)}</span>
      <span class="brand__name">{site.name}</span>
      <span class="brand__role">{site.role}</span>
    </a>

    <nav class="topnav" aria-label="主导航">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="topbar__right">
      <a class="topbar__search" href="/writing/" aria-label="浏览全部文章">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="vertical-align:-2px;margin-right:6px">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        </svg>搜索文章
      </a>
      <a class="avatar" href="/about/" aria-label={`关于 ${site.name}`}>
        <img src="/avatar.svg" alt="" width="34" height="34" />
      </a>
    </div>
  </div>
</header>
