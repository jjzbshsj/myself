---
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<div class="hot">
  <h4>热门文章</h4>
  <ol>
    {posts.map((p) => (
      <li>
        <a href={`/writing/${p.id}/`}>{p.data.title}</a>
      </li>
    ))}
  </ol>
</div>
