---
/**
 * 项目配图占位。用内联 SVG 画出界面线框，不请求任何图片资源。
 * 换成真实截图时，把 <svg> 换成 <Image> 或 <img> 即可。
 */
interface Props {
  variant: 'note' | 'chart' | 'ui';
}

const { variant } = Astro.props;

const ink = '#111827';
const line = '#D1D5DB';
const soft = '#E5E7EB';
const faint = '#F3F4F6';
const blue = '#1D4ED8';
const blueSoft = '#DBEAFE';
---

{
  variant === 'note' && (
    <svg viewBox="0 0 360 240" role="img" aria-label="Inkwell 编辑器界面示意">
      <rect x="0" y="0" width="360" height="240" fill="#fff" />
      <rect x="0" y="0" width="112" height="240" fill={faint} />
      <rect x="0" y="0" width="112" height="240" fill="none" stroke={soft} />
      <rect x="12" y="14" width="72" height="7" rx="3.5" fill={line} />
      <rect x="12" y="34" width="88" height="6" rx="3" fill={soft} />
      <rect x="12" y="48" width="64" height="6" rx="3" fill={soft} />
      <rect x="8" y="64" width="96" height="20" rx="4" fill={blueSoft} />
      <rect x="14" y="71" width="52" height="6" rx="3" fill={blue} />
      <rect x="12" y="92" width="76" height="6" rx="3" fill={soft} />
      <rect x="12" y="106" width="58" height="6" rx="3" fill={soft} />

      <rect x="132" y="26" width="150" height="11" rx="4" fill={ink} opacity="0.85" />
      <rect x="132" y="52" width="208" height="6" rx="3" fill={soft} />
      <rect x="132" y="66" width="196" height="6" rx="3" fill={soft} />
      <rect x="132" y="80" width="170" height="6" rx="3" fill={soft} />
      <rect x="132" y="102" width="88" height="6" rx="3" fill={blue} opacity="0.55" />
      <rect x="132" y="118" width="204" height="6" rx="3" fill={soft} />
      <rect x="132" y="132" width="188" height="6" rx="3" fill={soft} />
      <rect x="132" y="146" width="140" height="6" rx="3" fill={soft} />
      <rect x="132" y="170" width="220" height="34" rx="6" fill={faint} stroke={soft} />
      <rect x="144" y="182" width="96" height="5" rx="2.5" fill={line} />
      <rect x="144" y="193" width="70" height="5" rx="2.5" fill={soft} />
    </svg>
  )
}

{
  variant === 'chart' && (
    <svg viewBox="0 0 360 240" role="img" aria-label="Metric Deck 数据看板示意">
      <rect x="0" y="0" width="360" height="240" fill="#fff" />
      <rect x="16" y="16" width="64" height="6" rx="3" fill={line} />
      <rect x="16" y="30" width="40" height="12" rx="3" fill={ink} opacity="0.8" />
      <rect x="248" y="18" width="96" height="22" rx="5" fill={faint} stroke={soft} />
      <rect x="258" y="26" width="56" height="6" rx="3" fill={line} />

      <g>
        <rect x="16" y="60" width="328" height="1" fill={soft} />
        <rect x="16" y="106" width="328" height="1" fill={soft} />
        <rect x="16" y="152" width="328" height="1" fill={soft} />
        <rect x="16" y="198" width="328" height="1" fill={soft} />
      </g>

      <g fill={blueSoft}>
        <rect x="28" y="168" width="18" height="30" rx="2" />
        <rect x="56" y="146" width="18" height="52" rx="2" />
        <rect x="84" y="156" width="18" height="42" rx="2" />
        <rect x="112" y="128" width="18" height="70" rx="2" />
        <rect x="140" y="140" width="18" height="58" rx="2" />
        <rect x="168" y="112" width="18" height="86" rx="2" />
        <rect x="196" y="96" width="18" height="102" rx="2" />
        <rect x="224" y="118" width="18" height="80" rx="2" />
        <rect x="252" y="86" width="18" height="112" rx="2" />
        <rect x="280" y="102" width="18" height="96" rx="2" />
        <rect x="308" y="74" width="18" height="124" rx="2" />
      </g>

      <polyline
        points="37,150 65,132 93,140 121,108 149,118 177,92 205,80 233,100 261,68 289,84 317,56"
        fill="none"
        stroke={blue}
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="317" cy="56" r="3.5" fill={blue} />
      <circle cx="317" cy="56" r="7" fill="none" stroke={blue} stroke-opacity="0.25" />

      <rect x="252" y="40" width="92" height="30" rx="5" fill="#fff" stroke={soft} />
      <rect x="260" y="47" width="34" height="4" rx="2" fill={line} />
      <rect x="260" y="56" width="56" height="7" rx="3" fill={ink} opacity="0.75" />
    </svg>
  )
}

{
  variant === 'ui' && (
    <svg viewBox="0 0 360 240" role="img" aria-label="Prism UI 组件库示意">
      <rect x="0" y="0" width="360" height="240" fill="#fff" />

      <rect x="20" y="20" width="56" height="26" rx="6" fill={blue} />
      <rect x="34" y="30" width="28" height="6" rx="3" fill="#fff" opacity="0.9" />

      <rect x="86" y="20" width="56" height="26" rx="6" fill="#fff" stroke={line} />
      <rect x="100" y="30" width="28" height="6" rx="3" fill={line} />

      <rect x="152" y="20" width="26" height="26" rx="6" fill="#fff" stroke={line} />
      <rect x="161" y="29" width="8" height="8" rx="2" fill={blue} />

      <rect x="192" y="24" width="34" height="18" rx="9" fill={blueSoft} />
      <circle cx="218" cy="33" r="7" fill={blue} />

      <rect x="20" y="62" width="160" height="30" rx="6" fill="#fff" stroke={line} />
      <rect x="32" y="72" width="76" height="6" rx="3" fill={soft} />
      <rect x="140" y="68" width="1" height="18" fill={blue} />

      <rect x="192" y="62" width="148" height="30" rx="6" fill={faint} stroke={soft} />
      <rect x="204" y="72" width="60" height="6" rx="3" fill={line} />

      <rect x="20" y="108" width="120" height="26" rx="6" fill="#fff" stroke={line} />
      <circle cx="36" cy="121" r="5" fill="none" stroke={line} stroke-width="1.5" />
      <rect x="48" y="118" width="60" height="6" rx="3" fill={soft} />

      <rect x="152" y="108" width="188" height="26" rx="6" fill="#fff" stroke={soft} />
      <rect x="164" y="118" width="44" height="6" rx="3" fill={soft} />
      <rect x="216" y="118" width="44" height="6" rx="3" fill={soft} />
      <rect x="268" y="118" width="44" height="6" rx="3" fill={soft} />

      <rect x="20" y="150" width="320" height="70" rx="8" fill={faint} stroke={soft} />
      <rect x="32" y="162" width="90" height="6" rx="3" fill={line} />
      <rect x="32" y="176" width="140" height="6" rx="3" fill={soft} />
      <rect x="32" y="190" width="110" height="6" rx="3" fill={soft} />
      <rect x="232" y="176" width="96" height="26" rx="6" fill={blue} opacity="0.9" />
      <rect x="252" y="186" width="56" height="6" rx="3" fill="#fff" opacity="0.9" />
    </svg>
  )
}
