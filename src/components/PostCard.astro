---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writing'>;
  /** 已计算好的阅读时长（分钟） */
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const d = post.data.date;
const iso = d.toISOString().slice(0, 10);
const display = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<article class="article-card">
  <p class="meta">
    <time datetime={iso}>{display}</time>
    <span>{readingTime} 分钟</span>
    {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
  </p>
  <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.summary}</p>
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map((t) => (
        <span>{t}</span>
      ))}
    </div>
  )}
</article>
